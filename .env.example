# Fictional inventory with public GBP gold prices. No API key needed.
PORT=3107
CLIENT_PORT=5187
APP_ORIGIN=http://127.0.0.1:5187
PRICE_PROVIDER=public-gold
# Use PRICE_PROVIDER=fixture for deterministic offline prices.
LOCAL_DATABASE=pglite
# Local development enables clearly labelled fictional owner/staff accounts.
# Set false to reject demo passwords and existing demo sessions.
DEMO_ACCOUNTS=true
# Generate a secret for stable sessions / Docker / production:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
# SESSION_SECRET=paste-the-generated-value-here
# Hosted deployments require HTTPS APP_ORIGIN and a persistent SESSION_SECRET.
# Set this only for the exact number of trusted reverse proxies ahead of the API:
# TRUST_PROXY_HOPS=1
# For an existing PostgreSQL instance (Docker / hosted):
# DATABASE_URL=postgresql://quoteledger:local-demo-only@127.0.0.1:5437/quoteledger
# PGlite preview is the default; LOCAL_DATABASE=postgres uses a native local server.
# PRICE_PROVIDER=goldapi
# GOLDAPI_KEY=your-private-server-side-key
# Real-price adapter is optional; inventory and transactions remain fictional.
